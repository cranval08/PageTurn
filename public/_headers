# Netlify and Cloudflare Pages response headers. Keep in sync with vercel.json
# (tests/unit/deploy.test.ts checks). The main CSP is a <meta> in index.html
# (scripts/csp.mjs); a <meta> can't set frame-ancestors, so it is here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
