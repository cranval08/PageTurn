# Copy to .env.local and fill in. Never commit .env.local.
# Google sign-in, Drive Picker and progress sync. For production, set the same three
# variables in your host's settings (Vercel / Netlify); they are read at build time.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-picker-api-key
VITE_GOOGLE_APP_ID=your-cloud-project-number
